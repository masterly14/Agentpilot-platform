# Database
DATABASE_URL=

# Admin
ADMIN_PASSWORD=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=

# Meta / Facebook Pixel + Conversions API
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=1739545530581946
# Token de sistema (Events Manager). NO reutilizar WHATSAPP_ACCESS_TOKEN.
META_CAPI_ACCESS_TOKEN=
# Opcional: si se omite, se usa NEXT_PUBLIC_FACEBOOK_PIXEL_ID
META_PIXEL_ID="1739545530581946"
# Opcional: código de prueba de Events Manager
META_TEST_EVENT_CODE=
# META_GRAPH_API_VERSION=v23.0

# App URL (links de WhatsApp / QStash). Local: usa ngrok, p.ej. https://xxxx.ngrok-free.app
NEXT_PUBLIC_APP_URL=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# QStash (Upstash) — scheduler del pipeline WhatsApp
# Consola: https://console.upstash.com/qstash
# Local: PIPELINE_BASE_URL debe ser público (ngrok a :3000).
# Opcional: npx @upstash/qstash-cli dev  y QSTASH_SKIP_VERIFY=true
# Sim SQL local: pnpm pipeline:sim-sql (el server necesita QSTASH_SKIP_VERIFY=true)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
PIPELINE_BASE_URL=
PIPELINE_VIDEO_URL=
# QSTASH_SKIP_VERIFY=true

# Booking / Google Calendar via Composio
COMPOSIO_API_KEY=
COMPOSIO_CALENDAR_USER_ID=santiago-calendar
COMPOSIO_GOOGLE_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_TOOLKIT_VERSION_GOOGLECALENDAR=20260623_00

# Booking settings
BOOKING_TIMEZONE=America/Bogota
BOOKING_SLOT_MINUTES=40
BOOKING_WORK_START_HOUR=10
BOOKING_WORK_END_HOUR=18
BOOKING_MIN_NOTICE_MINUTES=120
BOOKING_CALENDAR_ID=primary

