// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id               String   @id @default(cuid())
  fullName         String
  email            String?
  phoneE164        String   @unique
  waId             String?  @unique
  phoneCountryCode String
  phoneNumber      String
  companyName      String?
  websiteUrl       String?
  instagramUrl     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  submissions   FormSubmission[]
  pipeline      LeadPipeline?
  conversations Conversation[]
  airbnbLead    AirbnbLead?

  @@index([email])
}

model FormSubmission {
  id                      String                  @id @default(cuid())
  fullName                String?
  email                   String?
  companyName             String?
  phoneCountryCode        String?
  phoneNumber             String?
  instagramUrl            String?
  websiteUrl              String?
  usesPms                 PmsUsage?
  propertyCount           PropertyCount?
  revenueRange            RevenueRange?
  isTodero                YesNo?
  usesAi                  YesNo?
  wantsToScale            YesNo?
  industryTime            IndustryTime?
  pdfToken                String                  @unique
  qualification           LeadQualification?
  qualificationScore      Int?
  disqualificationReason  DisqualificationReason?
  scoreBreakdown          Json?
  entrySource             LeadEntrySource         @default(EBOOK)
  bookingFlow             BookingFlow?
  bookedAt                DateTime?
  status                  SubmissionStatus        @default(NEW)
  fbclid                  String?
  fbp                     String?
  fbc                     String?
  utmSource               String?
  utmMedium               String?
  utmCampaign             String?
  utmContent              String?
  utmTerm                 String?
  landingPath             String?
  referrer                String?
  marketingFunnelStage    MarketingFunnelStage?
  contractValueUsd        Decimal?                @db.Decimal(12, 2)
  contractPlan            ContractPlan?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  contactId               String?
  contact                 Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull)
  events                  LeadEvent[]
  diagnoses               OperationalDiagnosis[]

  @@index([qualification])
  @@index([entrySource])
  @@index([bookingFlow])
  @@index([contactId])
  @@index([marketingFunnelStage])
}

model LeadEvent {
  id              String              @id
  submissionId    String?
  submission      FormSubmission?     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  airbnbLeadId    String?
  airbnbLead      AirbnbLead?         @relation(fields: [airbnbLeadId], references: [id], onDelete: Cascade)
  eventName       MarketingEventName
  eventTime       DateTime            @default(now())
  eventSourceUrl  String?
  value           Decimal             @db.Decimal(12, 2)
  currency        String              @default("USD")
  sentToMeta      Boolean             @default(false)
  metaResponse    Json?
  attemptCount    Int                 @default(0)
  lastAttemptAt   DateTime?
  triggeredBy     String
  clientIp        String?
  clientUserAgent String?
  createdAt       DateTime            @default(now())

  @@unique([submissionId, eventName])
  @@unique([airbnbLeadId, eventName])
  @@index([sentToMeta, createdAt])
  @@index([submissionId])
  @@index([airbnbLeadId])
}

model VideoWatchSession {
  id              String           @id @default(cuid())
  visitorId       String
  videoId         String
  startedAt       DateTime         @default(now())
  lastHeartbeatAt DateTime         @default(now())
  maxSecond       Int              @default(0)
  durationSeconds Int              @default(0)
  unlocked        Boolean          @default(false)
  completed       Boolean          @default(false)
  droppedAtSecond Int?
  dropReason      VideoDropReason?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([videoId, startedAt])
  @@index([visitorId])
  @@index([videoId, completed])
}

model LandingVisit {
  id           String    @id @default(cuid())
  visitorId    String
  landingPath  String
  fromAd       Boolean   @default(false)
  fbclid       String?
  fbp          String?
  fbc          String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  convertedAt  DateTime?
  conversion   String?
  lastSeenAt   DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([visitorId, landingPath])
  @@index([landingPath, fromAd])
  @@index([fromAd, convertedAt])
  @@index([fbclid])
}

model LeadPipeline {
  id                   String         @id @default(cuid())
  contactId            String         @unique
  contact              Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  funnelOrigin         FunnelOrigin
  currentStage         PipelineStage
  currentState         PipelineState
  scheduledJobId       String?
  scheduledJobDedupKey String?        @unique
  videoWatched         Boolean        @default(false)
  utmSource            String?
  pixelFiredAt         DateTime?
  painPoint            String?
  qualificationAnswers Json?
  meetingId            String?
  meetingTime          DateTime?
  meetLink             String?
  visitorTimezone      String?
  rescheduleContext    Json?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  jobs                 PipelineJob[]

  @@index([currentStage, currentState])
  @@index([funnelOrigin])
  @@index([currentState])
  @@index([meetingTime])
  @@index([scheduledJobId])
}

model Conversation {
  id              String              @id @default(cuid())
  contactId       String
  contact         Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel         ConversationChannel @default(WHATSAPP)
  waPhoneNumberId String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  messages        ConversationMessage[]

  @@unique([contactId, channel])
}

model ConversationMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  waMessageId    String?          @unique
  type           MessageType
  body           String?
  templateName   String?
  buttonId       String?
  rawPayload     Json?
  pipelineState  PipelineState?
  status         MessageStatus    @default(PENDING)
  mediaId        String?
  mimeType       String?
  mediaFilename  String?
  mediaUrl       String?
  caption        String?
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}

model PipelineJob {
  id              String            @id @default(cuid())
  pipelineId      String
  pipeline        LeadPipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  dedupKey        String            @unique
  expectedState   PipelineState
  qstashMessageId String?
  status          PipelineJobStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  executedAt      DateTime?

  @@index([pipelineId, status])
}

enum PmsUsage {
  YES
  NO
  EVALUATING
}

enum PropertyCount {
  UNDER_5
  FIVE_TO_FIFTEEN
  SIXTEEN_TO_TWENTY_FIVE
  OVER_25
}

enum RevenueRange {
  UNDER_10M
  TEN_TO_TWENTY_M
  TWENTY_ONE_TO_FIFTY_M
  OVER_50M
}

enum YesNo {
  YES
  NO
}

enum IndustryTime {
  UNDER_5
  FIVE_TO_TEN
  OVER_10
}

enum SubmissionStatus {
  PARTIAL
  NEW
  REVIEWING
  CONTACTED
  MEETING_SCHEDULED
  PROPOSAL_SENT
  CLOSED_WON
  CLOSED_LOST
}

enum LeadQualification {
  SQL
  MQL
  DISQUALIFIED
}

enum DisqualificationReason {
  REVENUE_VETO
  LOW_SCORE
}

enum LeadEntrySource {
  EBOOK
  DIAGNOSIS
  DIRECT_BOOKING
}

enum BookingFlow {
  EBOOK_SQL
  EBOOK_PDF
  DIAGNOSIS_PUBLIC
  DIRECT_BOOKING
}

enum FunnelOrigin {
  SQL
  MQL
  DIRECT_BOOKING
}

enum PipelineStage {
  NURTURING
  PRE_MEETING
  PRE_DEMO
  POST_DEMO
}

enum PipelineState {
  LEAD_MAGNET_DOWNLOADED
  AWAITING_CONFIRMATION
  QUALIFICATION_OFFERED
  QUALIFYING_Q1
  QUALIFYING_Q2
  QUALIFYING_Q3
  FIT_CONFIRMED
  DISQUALIFIED
  VIDEO_SENT
  CTA_SENT_SAW_VIDEO
  CTA_SENT_NO_VIDEO
  LAST_NURTURE_SENT
  COLD_CALL_QUEUED
  SCHEDULED
  LOST
  LONG_TERM_NURTURE
  MEETING_SCHEDULED
  CONFIRMATION_SENT
  REMINDER_48H
  REMINDER_24H
  REMINDER_8AM_DAY_OF
  REMINDER_30MIN
  NEED_RESCHEDULE
  ATTENDED
  NO_SHOW
  RESCHEDULE_OFFERED
  DISCOVERY_COMPLETED
  DISCOVERY_SUMMARY_SENT
  DEMO_CONFIRMATION_SENT
  DEMO_REMINDER_48H
  DEMO_REMINDER_24H
  DEMO_REMINDER_8AM
  DEMO_REMINDER_30MIN
  QUOTE_PRESENTED
  WON
  FORMAL_PROPOSAL_SENT
  FOLLOWUP_48H
  FOLLOWUP_5_7_DAYS
  CUTOFF_20_DAYS
}

enum ConversationChannel {
  WHATSAPP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageType {
  TEXT
  TEMPLATE
  BUTTON
  INTERACTIVE
  STATUS
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT
  STICKER
  LOCATION
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum PipelineJobStatus {
  PENDING
  EXECUTED
  STALE
  CANCELLED
}

enum MarketingFunnelStage {
  LEAD_MAGNET_SENT
  VIDEO_SENT
  SCHEDULED
  SHOWED_UP
  NO_SHOW
  DEMO_SCHEDULED
  DISCARDED
  PURCHASED
}

enum MarketingEventName {
  VIEW_CONTENT
  LEAD
  SCHEDULE
  SHOW_UP
  PURCHASE
}

enum ContractPlan {
  THREE_MONTH
  FIVE_MONTH
  OTHER
}

enum VideoDropReason {
  PAUSE
  TAB_HIDDEN
  PAGE_LEAVE
  SCROLL
  ENDED
}

// ------------------------------------------------------
// AIRBNB OUTBOUND (tablas físicas compartidas con @repo/db)
// ------------------------------------------------------

enum LeadStatus {
  LEAD_DISCOVERED
  INITIAL_MSG_SENT
  FOLLOW_UP_1_SENT
  FOLLOW_UP_2_SENT
  FOLLOW_UP_3_SENT
  REPLIED_IN_PROGRESS
  HUMAN_TAKEOVER
  CLOSED_WON
  CLOSED_LOST
}

enum IcpSkipReason {
  below_min
  above_max
  not_superhost
  hotel_loft
  wrong_market
}

enum AccountStatus {
  ACTIVE
  COOLDOWN
  BLOCKED
  PENDING_GMAIL
  PENDING_CREDENTIALS
  VERIFYING
}

enum BlockType {
  RATE_LIMIT
  IDENTITY
  CAPTCHA
  OTHER
}

enum ContactSource {
  OUTBOUND
  MANUAL_SYNC
  MANUAL_REGISTER
  AIRBNB_PRESEND_GUARD
  BACKFILL
}

enum AirbnbCommercialStage {
  HANDOFF
  SCHEDULED
  SHOWED_UP
  NO_SHOW
  PURCHASED
}

model AirbnbLead {
  id                 String         @id @default(uuid())
  hostAirbnbId       String         @unique
  threadId           String?        @unique
  name               String
  hostProfileUrl     String
  primaryListingUrl  String
  primaryListingName String?
  totalProperties    Int            @default(1)
  companyName        String?
  isSuperhost        Boolean        @default(false)
  market             String?
  icpSkipReason      IcpSkipReason?
  status             LeadStatus     @default(LEAD_DISCOVERED)
  businessScale      String?        @db.Text
  painPoints         String?        @db.Text
  executiveSummary   String?        @db.Text
  lastContactedAt    DateTime?
  nextFollowUpAt     DateTime?
  botReplyCount      Int            @default(0)
  calLinkSent        Boolean        @default(false)
  calBookedAt        DateTime?
  hostEmail          String?
  contactId          String?        @unique
  contact            Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages           AirbnbMessage[]
  calBookings        CalBooking[]
  hostContact        HostContact?
  commercial         AirbnbCommercial?
  events             LeadEvent[]
  diagnoses          OperationalDiagnosis[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, nextFollowUpAt])
  @@map("Lead")
}

model AirbnbMessage {
  id                String           @id @default(uuid())
  leadId            String
  lead              AirbnbLead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  prospectAccountId String?
  prospectAccount   ProspectAccount? @relation(fields: [prospectAccountId], references: [id], onDelete: SetNull)
  direction         MessageDirection
  content           String           @db.Text
  aiIntent          String?
  sentAt            DateTime         @default(now())

  @@index([leadId, sentAt])
  @@index([prospectAccountId])
  @@map("Message")
}

model SystemState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CalBooking {
  id            String     @id @default(uuid())
  calUid        String     @unique
  calBookingId  Int?
  leadId        String
  lead          AirbnbLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  triggerEvent  String
  startTime     DateTime
  endTime       DateTime?
  attendeeEmail String?
  attendeeName  String?
  eventTypeSlug String?
  createdAt     DateTime   @default(now())

  @@index([leadId])
}

model ProspectAccount {
  id                   String              @id @default(uuid())
  label                String
  airbnbEmail          String              @unique
  airbnbPasswordEnc    String?
  composioUserId       String?
  composioConnectionId String?
  composioConnectedAt  DateTime?
  proxyHost            String?
  proxyPort            Int?
  proxyUser            String?
  proxyPassEnc         String?
  proxyProvider        String?
  proxySessionId       String?
  proxyCountry         String?
  sessionPath          String?
  sessionStateEnc      String?
  market               String?
  messagesSentToday    Int                 @default(0)
  waveMessagesSent     Int                 @default(0)
  status               AccountStatus       @default(ACTIVE)
  rateLimitedAt        DateTime?
  cooldownUntil        DateTime?
  lastWaveStartedAt    DateTime?
  blockEvents          AccountBlockEvent[]
  messages             AirbnbMessage[]
  hostContacts         HostContact[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status, cooldownUntil])
}

model HostContact {
  id                    String           @id @default(uuid())
  hostAirbnbId          String           @unique
  leadId                String           @unique
  lead                  AirbnbLead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  firstContactedAt      DateTime
  firstContactAccountId String?
  firstContactAccount   ProspectAccount? @relation(fields: [firstContactAccountId], references: [id], onDelete: SetNull)
  source                ContactSource
  createdAt             DateTime         @default(now())

  @@index([firstContactAccountId])
}

model LeadIdentityAlias {
  id          String @id @default(uuid())
  aliasId     String @unique
  canonicalId String
  leadId      String?

  @@index([canonicalId])
}

model DailyOutboundStats {
  id               String   @id @default(uuid())
  date             DateTime @db.Date
  market           String
  coldMessagesSent Int      @default(0)

  @@unique([date, market])
  @@index([date])
}

model AccountBlockEvent {
  id         String          @id @default(uuid())
  accountId  String
  account    ProspectAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type       BlockType
  message    String          @db.Text
  occurredAt DateTime        @default(now())

  @@index([accountId, occurredAt])
}

model AirbnbCommercial {
  id               String                 @id @default(cuid())
  leadId           String                 @unique
  lead             AirbnbLead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  stage            AirbnbCommercialStage
  hostEmail        String?
  meetingTime      DateTime?
  meetLink         String?
  meetingId        String?
  contractValueUsd Decimal?               @db.Decimal(12, 2)
  contractPlan     ContractPlan?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
}

model OperationalDiagnosis {
  id             String          @id @default(cuid())
  slug           String          @unique
  clientName     String
  payload        Json
  submissionId   String?
  submission     FormSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  airbnbLeadId   String?
  airbnbLead     AirbnbLead?     @relation(fields: [airbnbLeadId], references: [id], onDelete: SetNull)
  meetingTime    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([updatedAt])
  @@index([submissionId])
  @@index([airbnbLeadId])
}
